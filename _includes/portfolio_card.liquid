{%- comment -%}
  One portfolio card. The panel stacks two images: an ITFA artwork filling it
  edge to edge, and the product screenshot on top, offset toward the bottom
  right so it runs off both edges. Styles are in _sass/_portfolio-cards.scss.
  Set `bg:` on a project to use a flat colour instead of `bg_img:`.

  Both images are served through the jekyll-imagemagick variants, with `sizes`
  measured from the real layout rather than figure.liquid's 95vw default — at
  these card widths that default would pull the 1400w file for a 260px slot.
  If a variant is missing the img's onerror drops that picture's <source>s and
  reloads, so the original is served instead of a broken image. It is scoped to
  the one picture and needs no jQuery, unlike figure.liquid's page-wide hack.
{%- endcomment -%}

{%- assign bg_base = project.bg_img | remove: '.jpg' | remove: '.jpeg' | remove: '.png' | remove: '.tiff' | remove: '.gif' -%}
{%- assign img_base = project.img | remove: '.jpg' | remove: '.jpeg' | remove: '.png' | remove: '.tiff' | remove: '.gif' -%}

<a
  class="pf-card"
  href="{% if project.redirect %}{{ project.redirect }}{% else %}{{ project.url | relative_url }}{% endif %}"
>
  <div class="pf-card__panel"{% if project.bg %} style="--pf-card-panel: {{ project.bg }};"{% endif %}>
    {% if project.bg_img %}
      <picture>
        {% if site.imagemagick.enabled %}
          <source
            class="responsive-img-srcset"
            srcset="{% for i in site.imagemagick.widths %}{{ bg_base | relative_url }}-{{ i }}.webp {{ i }}w,{% endfor %}"
            sizes="(min-width: 992px) 260px, (min-width: 576px) 46vw, 92vw"
            type="image/webp"
          >
        {% endif %}
        <img
          class="pf-card__bg"
          src="{{ project.bg_img | relative_url }}"
          alt=""
          aria-hidden="true"
          loading="lazy"
          decoding="async"
          onerror="this.onerror=null;var p=this.parentNode;if(p&&p.tagName==='PICTURE'){p.querySelectorAll('source').forEach(function(s){s.remove()});this.src=this.src;}"
        >
      </picture>
    {% endif %}

    {% if project.img %}
      <span class="pf-card__screen">
        <picture>
          {% if site.imagemagick.enabled %}
            <source
              class="responsive-img-srcset"
              srcset="{% for i in site.imagemagick.widths %}{{ img_base | relative_url }}-{{ i }}.webp {{ i }}w,{% endfor %}"
              sizes="(min-width: 992px) 208px, (min-width: 576px) 37vw, 74vw"
              type="image/webp"
            >
          {% endif %}
          <img
            src="{{ project.img | relative_url }}"
            alt=""
            loading="lazy"
            decoding="async"
            {% if project.img_width %}width="{{ project.img_width }}"{% endif %}
            {% if project.img_height %}height="{{ project.img_height }}"{% endif %}
            onerror="this.onerror=null;var p=this.parentNode;if(p&&p.tagName==='PICTURE'){p.querySelectorAll('source').forEach(function(s){s.remove()});this.src=this.src;}"
          >
        </picture>
      </span>
    {% endif %}
  </div>

  <div class="pf-card__body">
    <h2 class="pf-card__title">{{ project.title }}</h2>
    <p class="pf-card__text">{{ project.description }}</p>
  </div>

  <span class="pf-card__wash" aria-hidden="true"></span>
</a>
